rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Google sign-ins are verified automatically; email sign-ups must click the link first
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // Only this account can call races in the pool
    function isAdmin() { return verified() && request.auth.token.email == 'brad.w.crook@gmail.com'; }
    // Picks lock at 5:00 PM CT, Nov 3, 2026 (23:00 UTC)
    // Moderators (emails listed in admin/mods by the admin) can review reports, delete messages and ban
    function isMod() { return isAdmin() || (verified() && exists(/databases/$(database)/documents/admin/mods)
      && request.auth.token.email in get(/databases/$(database)/documents/admin/mods).data.emails); }
    function beforeLock() { return request.time < timestamp.value(1793746800000); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function cleanName(n) { return n is string && n.size() > 0 && n.size() <= 40; }
    function banned() { return exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    // A chat message: you agreed to the chat rules and aren't banned; right shape, your own uid, your saved
    // name, 1–500 characters, stamped with the current time, at least 3 seconds after your last message
    function goodMessage() {
      let m = request.resource.data;
      let before = me();
      return ('agreed' in before) && !banned()
        && m.keys().hasOnly(['uid', 'name', 'text', 'at'])
        && m.uid == request.auth.uid
        && m.name == before.name
        && m.text is string && m.text.size() > 0 && m.text.size() <= 500
        && m.at is int
        && m.at > request.time.toMillis() - 60000 && m.at < request.time.toMillis() + 60000
        && (!('lastChat' in before) || m.at >= before.lastChat + 3000)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastChat == m.at;
    }

    // Your profile is private to you (name, group codes, pick count, last chat time, blocked players, when you agreed to the chat rules)
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'groups', 'pickCount', 'lastChat', 'blocked', 'agreed'])
        && (!('blocked' in request.resource.data) || (request.resource.data.blocked is list && request.resource.data.blocked.size() <= 300))
        && (!('agreed' in request.resource.data) || request.resource.data.agreed is int)
        && (!('name' in request.resource.data) || cleanName(request.resource.data.name))
        && (!('groups' in request.resource.data) || (request.resource.data.groups is list && request.resource.data.groups.size() <= 20))
        && (!('pickCount' in request.resource.data) || request.resource.data.pickCount is int)
        && (!('lastChat' in request.resource.data) || request.resource.data.lastChat is int);
    }

    // Your own picks only, verified players only, and only before the lock. Others can see them after the lock.
    match /picks/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || !beforeLock());
      allow create, update: if verified() && request.auth.uid == uid && beforeLock()
        && request.resource.data.keys().hasOnly(['picks', 'seats', 'updated', 'lock', 'side']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Groups: look one up by its code; nobody can list them all
    match /groups/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if verified() && code.size() == 6
        && request.resource.data.keys().hasOnly(['name', 'owner', 'created'])
        && request.resource.data.owner == request.auth.uid
        && cleanName(request.resource.data.name);
      // Members: you add or remove only yourself, under the name saved on your profile
      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if verified() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'joined', 'pickCount'])
          && request.resource.data.name == me().name
          && (!('pickCount' in request.resource.data) || request.resource.data.pickCount is int);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      // Group chat: only members can read or post; delete your own (the admin can remove any)
      match /chat/{msg} {
        function isMember() { return signedIn() && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid)); }
        allow read: if isMember();
        allow create: if verified() && isMember() && goodMessage();
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMod());
      }
    }

    // Everyone chat: any signed-in player can read; verified players can post; delete your own (the admin can remove any)
    match /lobby/{msg} {
      allow read: if signedIn();
      allow create: if verified() && goodMessage();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMod());
    }

    // Reports of chat messages and "contact the organizer" notes: anyone signed in can send one; only the admin reads them
    match /reports/{id} {
      allow create: if verified() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'path', 'room', 'msgId', 'text', 'name', 'uid', 'by', 'note', 'at'])
        && request.resource.data.kind in ['message', 'contact']
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300));
      allow read, delete: if isMod();
    }

    // Players banned from posting in chat (set by the admin)
    match /banned/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMod());
      allow write: if isMod();
    }

    match /admin/mods {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails is list && request.resource.data.emails.size() <= 10;
    }

    match /admin/results {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Election Trivia — global leaderboard. One best score per player; it can only go up, and only as high as a
    // perfect game can score (Quick 10: 4,800). The name must match the player's saved game name.
    function goodTrivia(d) {
      return d.keys().hasOnly(['name', 'best', 'right', 'at'])
        && d.name == me().name
        && d.best is int && d.best >= 0 && d.best <= 4800
        && d.right is int && d.right >= 0 && d.right <= 10
        && d.at is int && d.at > request.time.toMillis() - 300000 && d.at < request.time.toMillis() + 60000;
    }
    match /trivia/{uid} {
      allow read: if signedIn();
      allow create: if verified() && request.auth.uid == uid && !banned() && goodTrivia(request.resource.data);
      allow update: if verified() && request.auth.uid == uid && !banned() && goodTrivia(request.resource.data)
        && (request.resource.data.best > resource.data.best
            || (request.resource.data.best == resource.data.best && request.resource.data.right == resource.data.right));
      allow delete: if (signedIn() && request.auth.uid == uid) || isMod();
    }
    // Daily 5 — the first finished Daily 5 of the day counts; one score per player per day, never changed
    match /triviaDaily/{day}/scores/{uid} {
      allow read: if signedIn();
      allow create: if verified() && request.auth.uid == uid && !banned()
        && day.matches('^2026-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'right', 'at'])
        && request.resource.data.name == me().name
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1800
        && request.resource.data.right is int && request.resource.data.right >= 0 && request.resource.data.right <= 5
        && request.resource.data.at is int && request.resource.data.at > request.time.toMillis() - 300000 && request.resource.data.at < request.time.toMillis() + 60000;
      allow delete: if (signedIn() && request.auth.uid == uid) || isMod();
    }
  }
}
